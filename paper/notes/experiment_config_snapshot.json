    "paramwise_cfg": {
      "norm_decay_mult": 0.0,
      "custom_keys": {
        "core.feature_aggregation": {
          "lr_mult": 1.0,
          "decay_mult": 1.0
        },
        "core.clip_text_encoder": {
          "lr_mult": 0.01,
          "decay_mult": 1.0
        },
        "core.clip_image_encoder": {
          "lr_mult": 0.01,
          "decay_mult": 1.0
        }
      }
    }
  },
  "param_scheduler": [
