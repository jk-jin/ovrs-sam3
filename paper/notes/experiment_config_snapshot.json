      "text_prompt_batch_size": 64,
      "text_prompt_use_checkpoint": true,
      "prompt_template_count": 64
    },
    "freeze": {
      "train_adapters_only": true,
      "trainable_modules": [
        "core.feature_aggregation"
      ],
      "frozen_modules": [],
