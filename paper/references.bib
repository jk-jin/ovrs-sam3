  urldate = {2026-11-09},
  abstract = {The recent introduction of \textbackslash texttt\textbraceleft SAM3\textbraceright{} has revolutionized Open-Vocabulary Segmentation (OVS) through \textbackslash textit\textbraceleft promptable concept segmentation\textbraceright, which grounds pixel predictions in flexible concept prompts. However, this reliance on pre-defined concepts makes the model vulnerable: when visual distributions shift (\textbackslash textit\textbraceleft data drift\textbraceright ) or conditional label distributions evolve (\textbackslash textit\textbraceleft concept drift\textbraceright ) in the target domain, the alignment between visual evidence and prompts breaks down. In this work, we present \textbackslash textsc\textbraceleft ConceptBank\textbraceright, a parameter-free calibration framework to restore this alignment on the fly. Instead of adhering to static prompts, we construct a dataset-specific concept bank from the target statistics. Our approach (\textbackslash textit\textbraceleft i\textbraceright ) anchors target-domain evidence via class-wise visual prototypes, (\textbackslash textit\textbraceleft ii\textbraceright ) mines representative supports to suppress outliers under data drift, and (\textbackslash textit\textbraceleft iii\textbraceright ) fuses candidate concepts to rectify concept drift. We demonstrate that \textbackslash textsc\textbraceleft ConceptBank\textbraceright{} effectively adapts \textbackslash texttt\textbraceleft SAM3\textbraceright{} to distribution drifts, including challenging natural-scene and remote-sensing scenarios, establishing a new baseline for robustness and efficiency in OVS. Code and model are available at https://github.com/pgsmall/ConceptBank.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computer Vision and Pattern Recognition},
