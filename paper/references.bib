  urldate = {2026-11-11},
  abstract = {Open-vocabulary remote sensing image segmentation (OVRSIS) aims to segment text-specified categories beyond a fixed label space. Its key challenge is to maintain reliable pixel--text correspondence under substantial appearance variation in remote-sensing imagery. Existing methods often rely on specialized vision--language representations or complex adaptation mechanisms, yet still perform deterministic matching between fixed text prototypes and individual visual features. We instead formulate OVRSIS as a \textbackslash emph\textbraceleft distributional pixel--text alignment\textbraceright{} problem and propose \textbackslash textbf\textbraceleft Pi-Seg\textbraceright, a lightweight perturbation-based framework. Pi-Seg introduces learnable variations into textual prototypes and dense visual features before alignment. Segmentation supervision encourages perturbations that enlarge the target-to-distractor margin while suppressing harmful feature shifts. Pi-Seg consistently improves performance under the existing \textbackslash textit\textbraceleft single-source\textbraceright{} OVRSISBench protocols. To evaluate OVRSIS beyond source-specific training settings, we further introduce a unified \textbackslash textit\textbraceleft multi-source\textbraceright{} protocol and construct \textbackslash textbf\textbraceleft GlobalRSOV95K\textbraceright, containing approximately 95K densely annotated images and 35 semantic categories. Models are trained on this shared dataset and evaluated on an image-disjoint suite of 10 downstream datasets. The complete benchmark covers more than 170K images and 122 categories. Experiments under both single-source and multi-source protocols show that Pi-Seg improves cross-dataset transfer and generalizes effectively to practical geospatial segmentation tasks, while GlobalRSOV95K provides a common foundation for transferable OVRSIS research. \textbackslash footnote\textbraceleft\textbackslash url\textbraceleft https://github.com/LiBingyu01/Pi-Seg\textbraceright\textbraceright},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computer Vision and Pattern Recognition},
  file = {/home/joker/Zotero/storage/Z7P72NU8/Li 等 - 2026 - Perturbation-Regularized Open-Vocabulary Remote Sensing Segmentation with Unified Multi-Domain Evalu.pdf;/home/joker/Zotero/storage/XVUIYPUB/2604.html}
}

@misc{liSegEarthOV3ExploringSAM2026,
