@article{yeOpenVocabularyRemoteSensing2025,
  title = {Towards {{Open-Vocabulary Remote Sensing Image Semantic Segmentation}}},
  author = {Ye, Chengyang and Zhuge, Yunzhi and Zhang, Pingping},
  year = 2025,
