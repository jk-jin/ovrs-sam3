{
  "schema_version": 1,
  "tables": [
    {
      "name": "main_loveda",
      "filter": {
        "evaluation.dataset": "loveda",
        "evaluation.split": "val"
      },
      "rows": [
        {
          "label": "ReCA-SAM3",
          "match": {
            "experiment.variant_id": "full",
            "experiment.method_id": "reca_sam3"
          }
        }
      ],
      "metrics": [
        "miou",
        "macc",
        "pixel_acc"
      ],
      "allowed_varying_fields": [
        "training.regime"
      ],
      "factor_columns": [
        "experiment.factors.num_blocks",
        "experiment.factors.directional_fusion"
      ],
      "display_unit": "percent",
      "decimals": 2,
      "aggregate_seeds": true,
      "std_ddof": 1,
      "layout": "column",
      "caption": "LoveDA 七类语义分割主结果",
      "label": "tab:main_loveda",
      "bold_best": false
    },
